<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Ascend — Scale Smarter, Not Harder</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <script type="importmap">
  {
    "imports": {
      "three": "https://unpkg.com/three@0.143.0/build/three.module.js",
      "three/examples/jsm/": "https://unpkg.com/three@0.143.0/examples/jsm/"
    }
  }
  </script>
  <style>
    :root{
      --bg:#04060f; --bg-2:#060a18; --ink:#f3f6ff; --muted:#9aa6c4; --muted-2:#6b7796;
      --line:rgba(150,175,230,.12); --line-strong:rgba(150,175,230,.22);
      --accent:#5df0a8; --accent-2:#2fd38a; --accent-ink:#032018;
      --glass:rgba(12,18,38,.55); --glass-2:rgba(16,24,48,.65);
      --radius:18px; --radius-lg:26px; --maxw:1180px;
      --shadow:0 30px 80px -30px rgba(0,0,0,.75);
      --font:'Inter',-apple-system,BlinkMacSystemFont,system-ui,sans-serif;
    }
    *{box-sizing:border-box;margin:0;padding:0}
    html{scroll-behavior:smooth}
    body{font-family:var(--font);color:var(--ink);background:var(--bg);-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility;overflow-x:hidden}
    a{color:inherit;text-decoration:none}
    /* Lenis */
    html.lenis,html.lenis body{height:auto}
    .lenis.lenis-smooth{scroll-behavior:auto !important}
    .lenis.lenis-smooth [data-lenis-prevent]{overscroll-behavior:contain}
    .lenis.lenis-stopped{overflow:hidden}
    /* staggered scroll-reveal */
    [data-reveal]{opacity:0;transform:translateY(26px);transition:opacity .7s cubic-bezier(.22,.7,.2,1),transform .7s cubic-bezier(.22,.7,.2,1);transition-delay:var(--rd,0ms);will-change:opacity,transform}
    [data-reveal].in{opacity:1;transform:none}
    /* fixed WebGL planet behind everything, never grabs pointer/scroll */
    .planet-canvas{position:fixed;inset:0;width:100vw;height:100vh;display:block;z-index:0;pointer-events:none}
    .page{position:relative;z-index:1}
    .section{position:relative;z-index:1;max-width:var(--maxw);margin:0 auto;padding:clamp(80px,12vw,160px) 24px}
    .eyebrow{display:inline-block;font-size:12px;font-weight:600;letter-spacing:.18em;text-transform:uppercase;color:var(--accent);margin-bottom:18px}
    .section-head{max-width:680px;margin:0 auto clamp(48px,6vw,80px);text-align:center}
    .section-head h2,.showcase-copy h2,.cta-card h2{font-size:clamp(30px,4.4vw,50px);font-weight:800;line-height:1.05;letter-spacing:-.02em;text-shadow:0 2px 40px rgba(0,0,0,.6)}
    .section-head p{margin-top:18px;color:var(--muted);font-size:18px;line-height:1.65;text-shadow:0 1px 24px rgba(0,0,0,.55)}
    /* buttons */
    .btn{display:inline-flex;align-items:center;gap:9px;font-size:15px;font-weight:600;padding:13px 22px;border-radius:999px;border:1px solid transparent;cursor:pointer;transition:transform .18s ease,box-shadow .25s ease,background .2s ease,border-color .2s ease;white-space:nowrap}
    .btn svg{width:17px;height:17px}
    .btn-primary{color:var(--accent-ink);background:linear-gradient(180deg,var(--accent),var(--accent-2));box-shadow:0 10px 30px -8px rgba(93,240,168,.55),inset 0 1px 0 rgba(255,255,255,.4)}
    .btn-primary:hover{transform:translateY(-2px);box-shadow:0 16px 38px -8px rgba(93,240,168,.7)}
    .btn-outline{color:var(--ink);background:rgba(255,255,255,.04);border-color:var(--line-strong);backdrop-filter:blur(10px)}
    .btn-outline:hover{background:rgba(255,255,255,.09);transform:translateY(-2px)}
    .btn-ghost{color:var(--ink);background:rgba(255,255,255,.05);border-color:var(--line-strong);padding:9px 18px}
    .btn-ghost:hover{background:rgba(255,255,255,.1)}

    /* Hero */
    .hero{min-height:100vh;display:flex;flex-direction:column;background:radial-gradient(125% 62% at 50% -10%, rgba(4,6,15,.82) 0%, rgba(4,6,15,.28) 44%, transparent 68%)}
    .nav{max-width:var(--maxw);margin:0 auto;padding:22px 24px;display:flex;justify-content:space-between;align-items:center}
    .brand{display:inline-flex;align-items:center;gap:9px;font-weight:800;font-size:19px;letter-spacing:.16em}
    .brand-mark{color:var(--accent);font-size:14px;transform:translateY(-1px);line-height:1}
    .nav-links{display:flex;gap:30;font-size:14.5px;color:var(--muted)}
    .nav-links a:hover{color:var(--ink)}
    .hero-inner{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;transform:translateY(-10vh);padding:0 24px}
    .hero-title{font-size:clamp(34px,5.2vw,62px);font-weight:800;line-height:1.04;letter-spacing:-.03em;max-width:15ch;text-shadow:0 2px 50px rgba(0,0,0,.55)}
    .hero-title em{font-style:normal;background:linear-gradient(180deg,var(--accent),var(--accent-2));-webkit-background-clip:text;background-clip:text;color:transparent}
    .hero-sub{margin-top:24px;max-width:560px;font-size:clamp(16px,2vw,19px);line-height:1.6;color:var(--muted)}
    .hero-actions{margin-top:38px;display:flex;gap:14px;justify-content:center;flex-wrap:wrap}
    .logos{padding:0 24px clamp(36px,6vw,64px);display:flex;flex-direction:column;align-items:center;gap:16px}
    .logos-label{font-size:12px;letter-spacing:.16em;text-transform:uppercase;color:var(--muted-2)}
    .logos-row{display:flex;flex-wrap:wrap;justify-content:center;gap:clamp(24px,5vw,56px)}
    .logo{font-size:17px;font-weight:700;color:var(--muted-2);opacity:.8;transition:color .2s ease,opacity .2s ease}
    .logo:hover{color:var(--ink);opacity:1}

    /* Features */
    .features{background:transparent}
    .feature-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
    .card{padding:30px;border-radius:var(--radius);background:var(--glass);border:1px solid var(--line);backdrop-filter:blur(14px);transition:transform .3s ease,border-color .3s ease,background .3s ease;position:relative;overflow:hidden}
    .card::before{content:"";position:absolute;inset:0;background:radial-gradient(120% 120% at 0% 0%, rgba(93,240,168,.08), transparent 45%);opacity:0;transition:opacity .3s ease;pointer-events:none}
    .card:hover{transform:translateY(-4px);border-color:var(--line-strong);background:var(--glass-2)}
    .card:hover::before{opacity:1}
    .card-icon{width:46px;height:46px;border-radius:12px;display:flex;align-items:center;justify-content:center;color:var(--accent);background:rgba(93,240,168,.1);border:1px solid rgba(93,240,168,.18);margin-bottom:18px}
    .card-icon svg{width:22px;height:22px}
    .card h3{font-size:19px;font-weight:700;margin-bottom:10px}
    .card p{font-size:15px;color:var(--muted);line-height:1.6}

    /* Showcase */
    .showcase{background:transparent}
    .showcase-grid{display:grid;grid-template-columns:1fr 1.05fr;gap:clamp(36px,6vw,72px);align-items:center}
    .showcase-copy{text-align:left}
    .showcase-copy .eyebrow{margin-bottom:18px}
    .showcase-copy h2{margin-bottom:18px;text-align:left}
    .showcase-copy p{color:var(--muted);font-size:18px;line-height:1.65;max-width:480px}
    .showcase-copy .hero-actions{margin-top:32px;justify-content:flex-start}
    .dashboard{padding:24px;border-radius:var(--radius-lg);background:var(--glass-2);border:1px solid var(--line-strong);box-shadow:var(--shadow);backdrop-filter:blur(18px);position:relative;overflow:hidden}
    .dashboard::after{content:"";position:absolute;inset:0;background:linear-gradient(160deg, rgba(93,240,168,.35), transparent 40%);mask:linear-gradient(#fff, #fff);-webkit-mask:linear-gradient(#fff, #fff);mask-composite:exclude;-webkit-mask-composite:xor;pointer-events:none}
    .dash-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:20px}
    .dash-top h3{font-size:15px;font-weight:600;color:var(--muted)}
    .dash-live{display:flex;align-items:center;gap:6px;font-size:12px;font-weight:600;color:var(--accent)}
    .dash-live::before{content:"";width:6px;height:6px;border-radius:50%;background:var(--accent);animation:pulse 1.5s ease-in-out infinite}
    @keyframes pulse{0%,100%{opacity:1}50%{opacity:.4}}
    .dash-bars{display:flex;align-items:flex-end;gap:10px;height:150px;background:rgba(0,0,0,.25);border:1px solid var(--line);border-radius:14px;padding:16px}
    .dash-bar{flex:1;border-radius:6px 6px 3px 3px;background:linear-gradient(180deg,var(--accent),rgba(47,211,138,.25));transform-origin:bottom;transform:scaleY(0);animation:grow .8s cubic-bezier(.22,.7,.2,1) forwards}
    @keyframes grow{to{transform:scaleY(1)}}
    .dash-rows{margin-top:20px;display:grid;grid-template-columns:120px 1fr;gap:14px;font-size:13.5px;color:var(--muted)}
    .dash-row{display:contents}
    .dash-label{padding-top:6px}
    .dash-track{height:8px;border-radius:999px;background:rgba(255,255,255,.06);overflow:hidden}
    .dash-fill{height:100%;border-radius:999px;background:linear-gradient(90deg,var(--accent-2),var(--accent));width:0;animation:fill .6s cubic-bezier(.22,.7,.2,1) forwards}
    @keyframes fill{to{width:var(--w)}}

    /* Stats */
    .stats{margin-top:clamp(56px,8vw,96px);display:grid;grid-template-columns:repeat(4,1fr);gap:18px}
    .stat{display:flex;flex-direction:column;align-items:center;text-align:center;padding:30px 18px;border-radius:var(--radius);background:var(--glass);border:1px solid var(--line);backdrop-filter:blur(12px)}
    .stat-value{font-size:clamp(30px,4vw,44px);font-weight:800;line-height:1.1;background:linear-gradient(180deg,#fff,var(--accent));-webkit-background-clip:text;background-clip:text;color:transparent}
    .stat-label{margin-top:8px;font-size:14px;color:var(--muted);line-height:1.5}

    /* CTA */
    .cta{background:transparent}
    .cta-card{text-align:center;max-width:760px;margin:0 auto;padding:clamp(48px,7vw,80px) clamp(28px,5vw,64px);border-radius:var(--radius-lg);background:radial-gradient(120% 140% at 50% 0%, rgba(93,240,168,.12), transparent 55%), var(--glass-2);border:1px solid var(--line-strong);box-shadow:var(--shadow);backdrop-filter:blur(18px)}
    .cta-card .eyebrow{margin-bottom:18px}
    .cta-card h2{margin-bottom:18px}
    .cta-card p{color:var(--muted);font-size:18px;line-height:1.65;max-width:520px;margin:0 auto}
    .cta-card .hero-actions{margin-top:32px;justify-content:center}

    /* Footer */
    .footer{display:flex;justify-content:space-between;gap:48px;flex-wrap:wrap;margin-top:clamp(64px,9vw,110px);padding-top:48px;border-top:1px solid var(--line)}
    .footer-brand{max-width:320px}
    .footer-brand .brand{margin-bottom:12px}
    .footer-brand p{font-size:15px;color:var(--muted);line-height:1.6}
    .footer-cols{display:flex;gap:60px;flex-wrap:wrap}
    .footer-col{min-width:140px}
    .footer-col h4{font-size:12px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:var(--muted-2);margin-bottom:16px}
    .footer-col ul{list-style:none;display:flex;flex-direction:column;gap:10px}
    .footer-col a{font-size:14px;color:var(--muted);transition:color .2s ease}
    .footer-col a:hover{color:var(--ink)}
    .copyright{text-align:center;margin-top:56px;font-size:13px;color:var(--muted-2);width:100%}

    /* Responsive */
    @media (max-width:980px){
      .feature-grid{grid-template-columns:repeat(2,1fr)}
      .showcase-grid{grid-template-columns:1fr;text-align:center}
      .showcase-copy{text-align:center}
      .showcase-copy h2{text-align:center}
      .showcase-copy p{margin-left:auto;margin-right:auto}
      .showcase-copy .hero-actions{justify-content:center}
      .stats{grid-template-columns:repeat(2,1fr)}
    }
    @media (max-width:720px){
      .nav-links{display:none}
      .nav{padding:18px 20px}
      .section{padding:clamp(64px,16vw,110px) 20px}
      .hero-inner{transform:translateY(-5vh)}
    }
    @media (max-width:560px){
      .feature-grid{grid-template-columns:1fr}
      .dash-rows{grid-template-columns:90px 1fr}
      .hero-actions .btn{flex:1;justify-content:center}
      .cta-card{padding:40px 22px}
      .footer{flex-direction:column;gap:32px}
      .footer-brand{max-width:none}
      .footer-cols{width:100%;justify-content:space-between}
    }
    @media (max-width:380px){
      .stats{grid-template-columns:1fr}
      .logo{font-size:14px}
    }
    @media (prefers-reduced-motion: reduce){
      [data-reveal]{opacity:1;transform:none;transition:none}
      .dash-bar,.dash-fill{animation:none;transform:scaleY(1);width:var(--w)}
      html{scroll-behavior:auto}
    }
  </style>
</head>
